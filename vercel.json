{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "^/([a-zA-Z0-9_-]+\\.html)$",
      "dest": "/frontend/$1"
    },
    {
      "src": "^/([a-zA-Z0-9_-]+)$",
      "dest": "/frontend/$1.html"
    },
    {
      "src": "^/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/frontend/$1"
    }
  ]
}
