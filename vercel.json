{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/login.html",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/register",
      "dest": "/frontend/register.html"
    },
    {
      "src": "/register.html",
      "dest": "/frontend/register.html"
    },
    {
      "src": "/dashboard-donor",
      "dest": "/frontend/dashboard-donor.html"
    },
    {
      "src": "/dashboard-donor.html",
      "dest": "/frontend/dashboard-donor.html"
    },
    {
      "src": "/dashboard-seeker",
      "dest": "/frontend/dashboard-seeker.html"
    },
    {
      "src": "/dashboard-seeker.html",
      "dest": "/frontend/dashboard-seeker.html"
    },
    {
      "src": "/dashboard-admin",
      "dest": "/frontend/dashboard-admin.html"
    },
    {
      "src": "/dashboard-admin.html",
      "dest": "/frontend/dashboard-admin.html"
    },
    {
      "src": "/dashboard-hospital",
      "dest": "/frontend/dashboard-hospital.html"
    },
    {
      "src": "/dashboard-hospital.html",
      "dest": "/frontend/dashboard-hospital.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
